{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Dovetail baseline: forwarder heartbeat loss. Doubles as the end-to-end test that the Repositories content pipeline reaches every enclave workspace."
  },
  "parameters": {
    "workspace": {
      "type": "string",
      "metadata": { "description": "Injected automatically by Sentinel Repositories" }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/', guid('dovetail-forwarder-heartbeat-loss'))]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "Dovetail Baseline - Log Forwarder Heartbeat Loss",
        "description": "A log forwarder has stopped sending heartbeats. In this deployment that means an entire enclave may be blind — treat as high priority. Common causes: uplink outage (check syslog-ng disk buffer depth on recovery), VM down, AMA service stopped.",
        "severity": "High",
        "enabled": true,
        "query": "Heartbeat | summarize LastHeartbeat = max(TimeGenerated) by Computer | where LastHeartbeat < ago(15m)",
        "queryFrequency": "PT15M",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [ "DefenseEvasion" ],
        "techniques": [ "T1562" ],
        "entityMappings": [
          {
            "entityType": "Host",
            "fieldMappings": [
              { "identifier": "HostName", "columnName": "Computer" }
            ]
          }
        ],
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities"
          }
        }
      }
    }
  ]
}
