{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspace": {
      "type": "string"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[concat(parameters('workspace'), '/Microsoft.SecurityInsights/', guid('dovetail-svc-critical-asset'))]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "OT/IT - New Service Installed on Critical Asset",
        "description": "A new Windows service (7045) was installed on a host listed in the critical-assets watchlist (EMS servers, historians, engineering workstations, jump hosts). Service installation on these assets should only occur during approved maintenance windows.",
        "severity": "High",
        "enabled": true,
        "query": "SecurityEvent\n| where EventID == 7045\n| join kind=inner (_GetWatchlist(\"critical-assets\") | project Computer = tostring(column_ifexists(\"hostname\",\"\"))) on Computer\n| extend TargetAccount = SubjectUserName\n| project TimeGenerated, Computer, TargetAccount, ServiceName = column_ifexists(\"ServiceName\",\"\"), ServiceFileName = column_ifexists(\"ServiceFileName\",\"\")",
        "queryFrequency": "PT30M",
        "queryPeriod": "PT30M",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [
          "Persistence"
        ],
        "techniques": [
          "T1543"
        ],
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "Name",
                "columnName": "TargetAccount"
              }
            ]
          },
          {
            "entityType": "Host",
            "fieldMappings": [
              {
                "identifier": "HostName",
                "columnName": "Computer"
              }
            ]
          }
        ],
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": true,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities"
          }
        }
      }
    }
  ]
}